			"\t\t} else {",
			"\t\t\treject();",
			"\t\t}",
			"\t});",
			"}",
			"$0",
			"// Reference",
			"${1:asyncFn}(param).then(function(result) {",
			"\t",
			"}, function(reason) {",
			"\t",
			"});"
		],
		"description": "Angular 1.x $q (ES6-style)\n",
		"scope": "javascript"
	},
	"Angular $q.all()": {
